import pandas as pd
import dns.resolver

def get_mx_records(domain):
    try:
        # Resolve MX records for the domain
        answers = dns.resolver.resolve(domain, 'MX')
        
        # MX records have a priority and an exchange (the server name)
        # We sort by priority (lowest number = highest priority)
        mx_list = sorted(answers, key=lambda r: r.preference)
        
        # Extract the hostnames and strip the trailing dot
        records = [f"{r.exchange.to_text().strip('.')}" for r in mx_list]
        
        return {
            "Domain": domain,
            "MX_Found": "Yes",
            "MX_Records": "; ".join(records),
            "Primary_Host": records[0] if records else "N/A"
        }
    except (dns.resolver.NXDOMAIN, dns.resolver.NoAnswer):
        return {"Domain": domain, "MX_Found": "No", "MX_Records": "None", "Primary_Host": "N/A"}
    except Exception as e:
        return {"Domain": domain, "MX_Found": "Error", "MX_Records": str(e), "Primary_Host": "N/A"}

# --- FILE PATHS ---
input_file = r"D:\domaintest.xlsx"
output_file = r"D:\mx_audit_results.xlsx"

print("Starting MX record extraction...")

# Load the Excel file
df = pd.read_excel(input_file)

# Process each domain
results = []
for index, row in df.iterrows():
    domain = str(row['Domain']).strip()
    print(f"Checking: {domain}")
    results.append(get_mx_records(domain))

# Save results to a new Excel file
output_df = pd.DataFrame(results)
output_df.to_excel(output_file, index=False)

print(f"\nDone! Results saved to: {output_file}")
